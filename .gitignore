# Virtual environment
.venv/
venv/
ENV/
env/
env.bak/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
#   For a library or package, you might want to ignore these files since the
#   code will run in multiple environments; otherwise, ignore them in your
#   project-level .gitignore.
.python-version

# VS Code
.vscode/

# Mac
.DS_Store

# Data
data/
